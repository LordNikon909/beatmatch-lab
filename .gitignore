.DS_Store
*.tmp

# Soundfonts are large, swappable local assets (see README). Only the one
# the app actually loads is committed, so a static deploy (e.g. Vercel)
# has it; anything else dropped in here stays local.
soundfonts/*
!soundfonts/GeneralUserGS.sf3

# Scratch/working folders. What the app actually loads lives in tracks/
# (MIDI) and sfx/ (sound effects) — move finished files there to ship them.
midis/
wavs/

# Reference material and local tooling — not part of the app.
Reference Assets/
Design/
.claude/
