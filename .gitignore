.DS_Store
*.tmp

# Soundfonts are large, swappable, user-supplied local assets (see README) —
# never committed, regardless of format.
soundfonts/

# Any subfolder of midis/ is scratch/source material (raw files, dated
# working batches) for producing the *_marked.mid files that actually ship
# at the top level of midis/; the app's preload only scans that top level.
midis/*/

# Reference material and local tooling — not part of the app.
Reference Assets/
Design/
.claude/

# Ableton analysis files and project folders from making SFX in wavs/
# (the .wav files themselves are loaded by the app and stay tracked).
*.asd
wavs/*Project/
